a test covers whichever is chosen;\n- `docs/configuration.md` (Release) says the build runs in a clean checkout."}},{"kind":"seen","author":"ee004d31386b76440a74651c79871f156633d4ff","time":1793004401,"data":{"issue":"e4891e6c722155e8b97bfbdba9a439736af437df","field":"status","value":"open"}},{"kind":"seen","author":"ee004d31386b76440a74651c79871f156633d4ff","time":1793004401,"data":{"issue":"e4891e6c722155e8b97bfbdba9a439736af437df","field":"labels","value":"kind:bug\nprio:p2\nstatus:backlog"}},{"kind":"seen","author":"ee004d31386b76440a74651c79871f156633d4ff","time":1793004401,"data":{"issue":"e4891e6c722155e8b97bfbdba9a439736af437df","field":"assignees","value":"161889"}}]}